[
    // JJ Split View Navigation
    // Arrow-based navigation to avoid conflicts with NeoVintageous
    // Up/Down: navigate between hunks (collapsed) or lines (expanded)
    // Right: expand hunk and enter it
    // Left: collapse hunk and exit to hunk level
    {
        "keys": ["up"],
        "command": "jj_split_nav_prev",
        "context": [{"key": "jj_split_view", "operand": true}]
    },
    {
        "keys": ["down"],
        "command": "jj_split_nav_next",
        "context": [{"key": "jj_split_view", "operand": true}]
    },
    {
        "keys": ["right"],
        "command": "jj_split_expand",
        "context": [{"key": "jj_split_view", "operand": true}]
    },
    {
        "keys": ["left"],
        "command": "jj_split_collapse",
        "context": [{"key": "jj_split_view", "operand": true}]
    },
    // Toggle selection with x (avoids space conflict with NeoVintageous)
    {
        "keys": ["x"],
        "command": "jj_split_toggle",
        "context": [{"key": "jj_split_view", "operand": true}]
    },
    // Select all / deselect all
    {
        "keys": ["ctrl+a"],
        "command": "jj_split_select_all",
        "context": [{"key": "jj_split_view", "operand": true}]
    },
    {
        "keys": ["ctrl+shift+a"],
        "command": "jj_split_deselect_all",
        "context": [{"key": "jj_split_view", "operand": true}]
    },
    // Confirm / Cancel
    {
        "keys": ["enter"],
        "command": "jj_split_confirm",
        "context": [{"key": "jj_split_view", "operand": true}]
    },
    {
        "keys": ["escape"],
        "command": "jj_split_cancel",
        "context": [{"key": "jj_split_view", "operand": true}]
    },
    // JJ Log View
    // Active only inside the read-only log view opened by "JJ: Log View"
    {
        "keys": ["enter"],
        "command": "jj_log_view_edit",
        "context": [{"key": "jj_log_view", "operand": true}]
    },
    {
        "keys": ["o"],
        "command": "jj_log_view_show_diff",
        "context": [{"key": "jj_log_view", "operand": true}]
    },
    {
        "keys": ["n"],
        "command": "jj_log_view_new",
        "context": [{"key": "jj_log_view", "operand": true}]
    },
    {
        "keys": ["d"],
        "command": "jj_log_view_describe",
        "context": [{"key": "jj_log_view", "operand": true}]
    },
    {
        "keys": ["a"],
        "command": "jj_log_view_abandon",
        "context": [{"key": "jj_log_view", "operand": true}]
    },
    {
        "keys": ["s"],
        "command": "jj_log_view_squash",
        "context": [{"key": "jj_log_view", "operand": true}]
    },
    {
        "keys": ["alt+up"],
        "command": "jj_log_view_move_up",
        "context": [{"key": "jj_log_view", "operand": true}]
    },
    {
        "keys": ["alt+down"],
        "command": "jj_log_view_move_down",
        "context": [{"key": "jj_log_view", "operand": true}]
    },
    {
        "keys": ["b"],
        "command": "jj_log_view_bookmark",
        "context": [{"key": "jj_log_view", "operand": true}]
    },
    {
        "keys": ["r"],
        "command": "jj_log_view_refresh",
        "context": [{"key": "jj_log_view", "operand": true}]
    },
    {
        "keys": ["?"],
        "command": "jj_log_view_help",
        "context": [{"key": "jj_log_view", "operand": true}]
    },
    {
        "keys": ["escape"],
        "command": "close",
        "context": [{"key": "jj_log_view", "operand": true}]
    }
]
