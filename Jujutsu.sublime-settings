{
    // Path to jj executable. Set to null to auto-detect from PATH.
    "jj_path": null,
    // Enable status bar with current change ID and description.
    "status_bar_enabled": true,
    // Debounce delay in seconds for updates after save.
    "debounce_delay": 0.5,
    // Enable debug logging.
    "debug": false,
    // Revset for the log view. Set to null to use jj's configured default.
    "log_view_revset": null,
    // Maximum number of changes shown in the log view.
    "log_view_limit": 200,
    // Default revset for "JJ: Run Command on Revset".
    "run_default_revset": "trunk()..@ | @",
    // Timeout in seconds for each per-change command run.
    "run_command_timeout": 600
}